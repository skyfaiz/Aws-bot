# Groww: use EITHER a fixed access token (expires daily 6 AM) ...
GROWW_ACCESS_TOKEN=
# ... OR an API key + secret (the bot fetches/renews the token itself; approve the key daily on the Groww Cloud API Keys page)
GROWW_API_KEY=
GROWW_API_SECRET=
# optional: TOTP flow instead of the secret
GROWW_TOTP_SECRET=
TELEGRAM_BOT_TOKEN=token_from_botfather
# Optional; defaults to 679902
TELEGRAM_PASSWORD=679902
